{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "https://gababo.co.kr/",
      "permanent": true
    },
    {
      "source": "/inquiry",
      "destination": "https://gababo.co.kr/inquiry",
      "permanent": true
    },
    {
      "source": "/works",
      "destination": "https://gababo.co.kr/archive",
      "permanent": true
    },
    {
      "source": "/works/:slug*",
      "destination": "https://gababo.co.kr/archive",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "https://gababo.co.kr/about",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "https://gababo.co.kr/privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "https://gababo.co.kr/terms",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "https://gababo.co.kr/about",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://gababo.co.kr/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
